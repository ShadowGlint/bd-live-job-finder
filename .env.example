# ============================================================================
# BD LIVE JOB FINDER — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env for local testing, or configure these keys in Render.

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Required: Your Telegram Numeric User ID (Comma-separated if multiple admins)
# Get your numeric ID from @userinfobot on Telegram
ADMIN_TELEGRAM_ID=123456789

# Server Port (Render sets PORT automatically)
PORT=3000

# Scraping Engine Settings
SCRAPE_CONCURRENCY=5
REQUEST_TIMEOUT_MS=20000
PLAYWRIGHT_TIMEOUT_MS=30000
ENABLE_PLAYWRIGHT=true

# Direct Apply Filter (true = exclude online portal form-only jobs by default; false = show all)
EXCLUDE_ONLINE_PORTAL_ONLY=true

# User Agent for polite scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36
